# --- LLM -------------------------------------------------------------------
# anthropic (default) or ollama
LLM_PROVIDER=anthropic          # anthropic | gemini | ollama | openai_compat
ANTHROPIC_API_KEY=
# Optional model override (defaults: claude-sonnet-5-5 / qwen2.5:7b)
# LLM_MODEL=

# Free hosted option: LLM_PROVIDER=gemini  (free key: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash        # check AI Studio for which models your free tier includes
# LLM_REASONING_EFFORT=low          # low | medium | high  (Gemini 3 cannot turn thinking off)
# LLM_MAX_CONCURRENCY=2             # parallel requests; lower this if you hit rate limits
#
# Any other OpenAI-compatible provider (Groq, OpenRouter, Mistral...):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Local alternative: LLM_PROVIDER=ollama  (model must support tool calling)
# OLLAMA_HOST=http://localhost:11434
# Embeddings for RAG (optional; falls back to TF-IDF if unavailable)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Services ----------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8001/sse
# Default is a local SQLite file; use postgresql://... for production
# DATABASE_URL=sqlite:///finance_sim.db

# --- Security ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,null

# --- Local model tuning (Ollama) --------------------------------------------
# Requests to a local model are queued one at a time; raise only if you have the memory for it.
# OLLAMA_MAX_CONCURRENCY=1
# Seconds to wait for one model reply (small laptops running 7B models may need more)
# LLM_TIMEOUT=300