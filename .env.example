# --- LLM -------------------------------------------------------------------
# anthropic (default) or ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (defaults: claude-sonnet-5-5 / qwen2.5:7b)
# LLM_MODEL=

# Local alternative: LLM_PROVIDER=ollama  (model must support tool calling)
# OLLAMA_HOST=http://localhost:11434
# Embeddings for RAG (optional; falls back to TF-IDF if unavailable)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Services ----------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8001/sse
# Default is a local SQLite file; use postgresql://... for production
# DATABASE_URL=sqlite:///finance_sim.db

# --- Security ----------------------------------------------------------------
# Required to use mutating admin endpoints (/security/*). Unset = admin API disabled.
# ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,null

# --- Local model tuning (Ollama) --------------------------------------------
# Requests to a local model are queued one at a time; raise only if you have the memory for it.
# OLLAMA_MAX_CONCURRENCY=1
# Seconds to wait for one model reply (small laptops running 7B models may need more)
# LLM_TIMEOUT=300
